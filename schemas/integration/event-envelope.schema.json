{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buddy-agency.local/schemas/event-envelope-v1.json",
  "title": "Buddy Agency Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "actor",
    "source_project",
    "correlation_id",
    "subject_ref",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,100}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actor_type": {
          "enum": [
            "owner",
            "agent",
            "service",
            "system"
          ]
        }
      }
    },
    "source_project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 100
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
