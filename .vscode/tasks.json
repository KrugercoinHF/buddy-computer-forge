{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Buddy Skill Factory: propose current diff",
      "type": "process",
      "command": "python",
      "args": [
        "-m", "repo_maintainer.skill_factory", "propose",
        "--workspace", "${workspaceFolder}",
        "--repository", "KrugercoinHF/buddy-computer-forge",
        "--base", "buddy-agency-integration"
      ],
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Buddy Skill Factory: evaluate in isolated Docker",
      "type": "process",
      "command": "python",
      "args": [
        "-m", "repo_maintainer.skill_factory", "evaluate",
        "--workspace", "${workspaceFolder}",
        "--repository", "KrugercoinHF/buddy-computer-forge",
        "--base", "buddy-agency-integration",
        "--sandbox-image", "${input:buddySandboxImage}",
        "--checks", "pytest"
      ],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "buddySandboxImage",
      "type": "promptString",
      "description": "Prebuilt, audited test-runner image pinned as image@sha256:<64 hex>",
      "default": ""
    }
  ]
}
